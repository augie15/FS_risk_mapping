# systemd unit for the FS Risk Mapping app on the home server.
#
# Install (see deploy/README.md):
#   sudo cp deploy/fsmapping.service /etc/systemd/system/fsmapping.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now fsmapping
#
# Listens on 127.0.0.1:8800 only. Caddy terminates TLS, checks the password (basic_auth) and
# reverse-proxies to it. Never change --host to 0.0.0.0: the app has no login of its own.

[Unit]
Description=FS Risk Mapping (FireSmart-based home assessment prototype)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=augie
Group=augie
WorkingDirectory=/home/augie/FS_risk_mapping
# .env (API keys, OLLAMA_HOST, caps) is read by the app itself from the working directory.
Environment=PYTHONUNBUFFERED=1
# GDAL (inside the rasterio wheel) reads orthophotos over HTTPS; point it at the system CA list.
Environment=CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# One worker: jobs, the in-flight spend reservation and locks live in this one process.
ExecStart=/home/augie/FS_risk_mapping/.venv/bin/uvicorn backend.app:app \
    --host 127.0.0.1 --port 8800 --workers 1 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header
Restart=on-failure
RestartSec=5

# Hardening. The app writes only under data/ in the checkout.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/augie/FS_risk_mapping/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=8G

[Install]
WantedBy=multi-user.target
